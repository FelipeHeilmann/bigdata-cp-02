# Copie este arquivo para .env e ajuste os valores.
# O .env nao deve ser versionado (ja esta no .gitignore).

# Credenciais do usuario root do MongoDB (usadas pelo docker-compose)
MONGO_USER=user
MONGO_PASSWORD=ZHNhZGFkYWRhc2Rh

# Nome do banco usado pela aplicacao
MONGO_DATABASE=library

# URI usada ao rodar a aplicacao direto na maquina (fora do Docker).
# Dentro do Docker o compose monta a URI com o host "mongo".
MONGO_URI=mongodb://user:ZHNhZGFkYWRhc2Rh@localhost:27017/?authSource=admin
